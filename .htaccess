<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# ── Canonical Host & HTTPS: www -> non-www & http -> https (Task 3) ──
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^gnc\.edu\.in$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Uppercase URL → lowercase 301 redirects ──────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/AICTE-documents[?\s] [NC]
RewriteRule ^AICTE-documents$ %1/aicte-documents [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/B-Pharm-Lateral-Entry-Colleges-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^B-Pharm-Lateral-Entry-Colleges-in-Dehradun-Uttarakhand$ %1/b-pharm-lateral-entry-colleges-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-B-Sc-Nursing-Colleges-in-dehradun[?\s] [NC]
RewriteRule ^Best-B-Sc-Nursing-Colleges-in-dehradun$ %1/best-b-sc-nursing-colleges-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-BMRIT-bachelor-in-medical-radio-imagingtechnology-college-in-dehradun[?\s] [NC]
RewriteRule ^Best-BMRIT-bachelor-in-medical-radio-imagingtechnology-college-in-dehradun$ %1/best-bmrit-bachelor-in-medical-radio-imagingtechnology-college-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-BPT-college-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Best-BPT-college-in-Dehradun-Uttarakhand$ %1/best-bpt-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Bsc-Agriculture-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Best-Bsc-Agriculture-College-in-Dehradun-Uttarakhand$ %1/best-bsc-agriculture-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Bsc-Forestry-colleges-in-Dehradun[?\s] [NC]
RewriteRule ^Best-Bsc-Forestry-colleges-in-Dehradun$ %1/best-bsc-forestry-colleges-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-College-For-Computer-Science-in-Dehradun[?\s] [NC]
RewriteRule ^Best-College-For-Computer-Science-in-Dehradun$ %1/best-college-for-computer-science-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-College-for-BCA-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Best-College-for-BCA-in-Dehradun-Uttarakhand$ %1/best-college-for-bca-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-College-for-BTech-Computer-Science-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Best-College-for-BTech-Computer-Science-in-Dehradun-Uttarakhand$ %1/best-college-for-btech-computer-science-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-College-for-D-Pharm-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Best-College-for-D-Pharm-in-Dehradun-Uttarakhand$ %1/best-college-for-d-pharm-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-DHM-Colleges-in-Dehradun[?\s] [NC]
RewriteRule ^Best-DHM-Colleges-in-Dehradun$ %1/best-dhm-colleges-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Diploma-in-Dialysis-Technology[?\s] [NC]
RewriteRule ^Best-Diploma-in-Dialysis-Technology$ %1/best-diploma-in-dialysis-technology [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Hotel-Management-College-in-Dehradun[?\s] [NC]
RewriteRule ^Best-Hotel-Management-College-in-Dehradun$ %1/best-hotel-management-college-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Hotel-Management-Colleges-in-Dehradun-2026[?\s] [NC]
RewriteRule ^Best-Hotel-Management-Colleges-in-Dehradun-2026$ %1/best-hotel-management-colleges-in-dehradun-2026 [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-MPT-Master-of-Physiotherapy-College[?\s] [NC]
RewriteRule ^Best-MPT-Master-of-Physiotherapy-College$ %1/best-mpt-master-of-physiotherapy-college [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Management-College-in-Dehradun[?\s] [NC]
RewriteRule ^Best-Management-College-in-Dehradun$ %1/best-management-college-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-Msc-Agronomy-Colleges-in-Dehradun[?\s] [NC]
RewriteRule ^Best-Msc-Agronomy-Colleges-in-Dehradun$ %1/best-msc-agronomy-colleges-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-bmlt-college-in-dehradun[?\s] [NC]
RewriteRule ^Best-bmlt-college-in-dehradun$ %1/best-bmlt-college-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-bsc-optometry-College-in-dehradun[?\s] [NC]
RewriteRule ^Best-bsc-optometry-College-in-dehradun$ %1/best-bsc-optometry-college-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Best-operation-theatre-technology-colleges-in-dehradun[?\s] [NC]
RewriteRule ^Best-operation-theatre-technology-colleges-in-dehradun$ %1/best-operation-theatre-technology-colleges-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Bsc-geology-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Bsc-geology-College-in-Dehradun-Uttarakhand$ %1/bsc-geology-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Bsc-microbiology-Colleges-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Bsc-microbiology-Colleges-in-Dehradun-Uttarakhand$ %1/bsc-microbiology-colleges-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Bsc-pcm-Colleges-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Bsc-pcm-Colleges-in-Dehradun-Uttarakhand$ %1/bsc-pcm-colleges-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/ManagementStudies[?\s] [NC]
RewriteRule ^ManagementStudies$ %1/managementstudies [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Nursing-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Nursing-College-in-Dehradun-Uttarakhand$ %1/nursing-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Paramedical-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Paramedical-College-in-Dehradun-Uttarakhand$ %1/paramedical-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Pharmacy-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Pharmacy-College-in-Dehradun-Uttarakhand$ %1/pharmacy-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Top-College-for-Life-and-Allied-Sciences-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Top-College-for-Life-and-Allied-Sciences-in-Dehradun-Uttarakhand$ %1/top-college-for-life-and-allied-sciences-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/Top-Health-Science-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^Top-Health-Science-College-in-Dehradun-Uttarakhand$ %1/top-health-science-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/best-College-for-B-Pharmacy-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^best-College-for-B-Pharmacy-in-Dehradun-Uttarakhand$ %1/best-college-for-b-pharmacy-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/msc-botany-Colleges-in-Uttarakhand[?\s] [NC]
RewriteRule ^msc-botany-Colleges-in-Uttarakhand$ %1/msc-botany-colleges-in-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/msc-chemistry-Colleges-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^msc-chemistry-Colleges-in-Dehradun-Uttarakhand$ %1/msc-chemistry-colleges-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/msc-food-tech-Colleges-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^msc-food-tech-Colleges-in-Dehradun-Uttarakhand$ %1/msc-food-tech-colleges-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/msc-microbiology-Colleges-in-Dehradun[?\s] [NC]
RewriteRule ^msc-microbiology-Colleges-in-Dehradun$ %1/msc-microbiology-colleges-in-dehradun [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/msc-physics-College-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^msc-physics-College-in-Dehradun-Uttarakhand$ %1/msc-physics-college-in-dehradun-uttarakhand [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/msc-zoology-Colleges-in-Dehradun-Uttarakhand[?\s] [NC]
RewriteRule ^msc-zoology-Colleges-in-Dehradun-Uttarakhand$ %1/msc-zoology-colleges-in-dehradun-uttarakhand [R=301,L]

# ── Remove .php extension & index.php (Task 4) ────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/index\.php[?\s] [NC]
RewriteRule ^index\.php$ %1/ [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/events\.php[?\s] [NC]
RewriteRule ^events\.php$ %1/events [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*?)/event-details\.php\?slug=([^&\s]+) [NC]
RewriteRule ^event-details\.php$ %1/event/%2? [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[?\s] [NC]
RewriteRule ^ %1 [R=301,L]

# ── Internal Rewrites ─────────────────────────────────────────
RewriteRule ^event/([^/]+)$ event-details.php?slug=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [QSA,NC,L]

</IfModule>
